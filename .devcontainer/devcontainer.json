{
  "name": "Data 8 & Otter-Grader Environment",
  // Використовуємо офіційний, оптимізований образ від Microsoft із попередньо встановленим Python 3
  "image": "://microsoft.com",

  "customizations": {
    "vscode": {
      // Автоматично інсталюємо необхідні плагіни у VS Code студента
      "extensions": [
        "ms-python.python",            // Підтримка мови Python
        "ms-toolsai.jupyter",          // Інтерфейс для роботи з .ipynb записниками
        "ms-python.vscode-pylance"     // Автодоповнення та підказки коду
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookEditor.defaultCellMarker": "# %%"
      }
    }
  },

  // Автоматично встановлюємо всі бібліотеки з requirements.txt відразу після створення контейнера
  "postCreateCommand": "pip install --no-cache-dir -r .devcontainer/requirements.txt"
}
